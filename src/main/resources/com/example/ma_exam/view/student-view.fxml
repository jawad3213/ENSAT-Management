<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="650.0" prefWidth="850.0" spacing="20.0" styleClass="content-panel" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ma_exam.controller.StudentController">
   <padding>
      <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
   </padding>
   <children>
      <!-- Header Section -->
      <VBox spacing="5.0">
         <children>
            <Label text="Gestion des Étudiants" textFill="#1a237e">
               <font>
                  <Font name="System Bold" size="26.0" />
               </font>
            </Label>
            <Label text="Gérez les informations personnelles et académiques des élèves." textFill="#7f8c8d">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
         </children>
      </VBox>

      <!-- Form Section -->
      <VBox spacing="15.0">
         <children>
            <!-- First Line: Matricule, Prenom, Nom -->
            <HBox spacing="20.0">
               <children>
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Matricule" textFill="#2c3e50">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtMatricule" prefHeight="35.0" prefWidth="120.0" promptText="Ex: 2025-001" style="-fx-background-radius: 5;" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Prénom" textFill="#2c3e50">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtPrenom" prefHeight="35.0" promptText="Prénom de l'étudiant" style="-fx-background-radius: 5;" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Nom" textFill="#2c3e50">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtNom" prefHeight="35.0" promptText="Nom de l'étudiant" style="-fx-background-radius: 5;" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- Second Line: Email, Filière, Statut -->
            <HBox spacing="20.0">
               <children>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Email (Contact)" textFill="#2c3e50">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtEmail" prefHeight="35.0" promptText="exemple@domain.com" style="-fx-background-radius: 5;" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Filière Affectée" textFill="#2c3e50">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                        <ComboBox fx:id="comboFiliere" prefHeight="35.0" prefWidth="200.0" promptText="Choisir..." style="-fx-background-radius: 5;" />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>

      <!-- Actions Section -->
      <HBox alignment="CENTER" spacing="30.0">
         <children>
            <Button mnemonicParsing="false" onAction="#handleAdd" prefHeight="40.0" prefWidth="180.0" style="-fx-background-color: #2ECC71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="AJOUTER" />
            <Button mnemonicParsing="false" onAction="#handleUpdate" prefHeight="40.0" prefWidth="180.0" style="-fx-background-color: #3498DB; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="MODIFIER" />
            <Button mnemonicParsing="false" onAction="#handleDelete" prefHeight="40.0" prefWidth="180.0" style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="SUPPRIMER" />
         </children>
      </HBox>

      <!-- Table Section -->
      <TableView fx:id="tableStudents" onMouseClicked="#handleTableSelection" prefHeight="300.0" prefWidth="800.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colMatricule" maxWidth="120.0" minWidth="80.0" prefWidth="100.0" text="MATRICULE" />
          <TableColumn fx:id="colPrenom" prefWidth="120.0" text="PRÉNOM" />
            <TableColumn fx:id="colNom" prefWidth="120.0" text="NOM" />
            <TableColumn fx:id="colEmail" prefWidth="180.0" text="EMAIL" />
            <TableColumn fx:id="colFiliere" prefWidth="150.0" text="FILIÈRE" />
            <TableColumn fx:id="colStatus" maxWidth="100.0" prefWidth="90.0" text="STATUT" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
