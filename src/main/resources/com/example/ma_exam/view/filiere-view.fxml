<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="650.0" prefWidth="850.0" spacing="20.0" styleClass="content-panel" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ma_exam.controller.FiliereController">
   <padding>
      <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
   </padding>
   <children>
      <!-- Header Section -->
      <VBox spacing="5.0">
         <children>
            <Label text="Gestion des Filières" textFill="#1a237e">
               <font>
                  <Font name="System Bold" size="26.0" />
               </font>
            </Label>
            <Label text="Configurez les programmes académiques et leurs descriptions." textFill="#7f8c8d">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
         </children>
      </VBox>

      <!-- Form Section -->
      <VBox spacing="15.0">
         <children>
            <!-- First Line: Code (Short) and Name (Long) -->
            <HBox spacing="20.0">
               <children>
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Code Filière" textFill="#2c3e50">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtCode" prefHeight="35.0" prefWidth="150.0" promptText="Ex: INFO" style="-fx-background-radius: 5;" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Nom Complet de la Filière" textFill="#2c3e50">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtNom" prefHeight="35.0" promptText="Ex: Ingénierie Informatique..." style="-fx-background-radius: 5;" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- Second Line: Description (Full Width) -->
            <VBox spacing="5.0">
               <children>
                  <Label text="Description et Objectifs" textFill="#2c3e50">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Label>
                  <TextArea fx:id="txtDescription" prefHeight="80.0" promptText="Détails de la filière..." style="-fx-background-radius: 5;" wrapText="true" />
               </children>
            </VBox>
         </children>
      </VBox>

      <!-- Actions Section -->
      <HBox alignment="CENTER" spacing="15.0">
         <children>
            <Button mnemonicParsing="false" onAction="#handleAdd" prefHeight="40.0" prefWidth="140.0" style="-fx-background-color: #2ECC71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="AJOUTER" />
            <Button mnemonicParsing="false" onAction="#handleUpdate" prefHeight="40.0" prefWidth="140.0" style="-fx-background-color: #3498DB; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="MODIFIER" />
            <Button mnemonicParsing="false" onAction="#handleDelete" prefHeight="40.0" prefWidth="140.0" style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="SUPPRIMER" />
            <Button mnemonicParsing="false" onAction="#handleClear" prefHeight="40.0" prefWidth="140.0" style="-fx-background-color: #95A5A6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="VIDER" />
         </children>
      </HBox>

      <HBox spacing="15.0" VBox.vgrow="ALWAYS">
         <children>
            <!-- Table Section -->
            <TableView fx:id="tableFiliere" prefHeight="300.0" prefWidth="500.0" HBox.hgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colId" maxWidth="50.0" minWidth="35.0" prefWidth="40.0" text="ID" />
                <TableColumn fx:id="colCode" prefWidth="70.0" text="CODE" />
                  <TableColumn fx:id="colNom" prefWidth="130.0" text="NOM" />
                  <TableColumn fx:id="colNbEleves" prefWidth="60.0" text="ÉLÈVES" />
                  <TableColumn fx:id="colDescription" prefWidth="150.0" text="DESCRIPTION" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>

            <!-- Courses offered by the selected filière (filiere_cours) -->
            <VBox prefWidth="200.0" spacing="8.0">
               <children>
                  <Label text="Cours de la filière" textFill="#2c3e50">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Label>
                  <ListView fx:id="listCours" prefWidth="200.0" VBox.vgrow="ALWAYS" />
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleSaveCours" prefHeight="35.0" style="-fx-background-color: #1a237e; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="ENREGISTRER" />
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
