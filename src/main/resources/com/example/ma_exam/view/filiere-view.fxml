<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="650.0" prefWidth="850.0" spacing="20.0" styleClass="content-panel" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ma_exam.controller.FiliereController">
   <padding>
      <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
   </padding>
   <children>
      <!-- Header Section -->
      <VBox spacing="5.0">
         <children>
            <Label text="Gestion des Filières" textFill="#1a237e">
               <font>
                  <Font name="System Bold" size="26.0" />
               </font>
            </Label>
            <Label text="Configurez les programmes académiques et leurs descriptions." textFill="#7f8c8d">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
         </children>
      </VBox>

      <!-- Form Section -->
      <VBox spacing="15.0">
         <children>
            <!-- First Line: Code (Short) and Name (Long) -->
            <HBox spacing="20.0">
               <children>
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Code Filière" textFill="#2c3e50">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtCode" prefHeight="35.0" prefWidth="150.0" promptText="Ex: INFO" style="-fx-background-radius: 5;" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Nom Complet de la Filière" textFill="#2c3e50">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtNom" prefHeight="35.0" promptText="Ex: Ingénierie Informatique..." style="-fx-background-radius: 5;" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- Second Line: Description (Full Width) -->
            <VBox spacing="5.0">
               <children>
                  <Label text="Description et Objectifs" textFill="#2c3e50">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Label>
                  <TextArea fx:id="txtDescription" prefHeight="80.0" promptText="Détails de la filière..." style="-fx-background-radius: 5;" wrapText="true" />
               </children>
            </VBox>
         </children>
      </VBox>

      <!-- Actions Section -->
      <HBox alignment="CENTER" spacing="30.0">
         <children>
            <Button mnemonicParsing="false" onAction="#handleAdd" prefHeight="40.0" prefWidth="180.0" style="-fx-background-color: #2ECC71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="AJOUTER" />
            <Button mnemonicParsing="false" onAction="#handleUpdate" prefHeight="40.0" prefWidth="180.0" style="-fx-background-color: #3498DB; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="MODIFIER" />
            <Button mnemonicParsing="false" onAction="#handleDelete" prefHeight="40.0" prefWidth="180.0" style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="SUPPRIMER" />
         </children>
      </HBox>

      <!-- Table Section -->
      <TableView fx:id="tableFiliere" onMouseClicked="#handleTableSelection" prefHeight="300.0" prefWidth="750.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colId" maxWidth="60.0" minWidth="40.0" prefWidth="50.0" text="ID" />
          <TableColumn fx:id="colCode" maxWidth="150.0" minWidth="80.0" prefWidth="100.0" text="CODE" />
            <TableColumn fx:id="colNom" maxWidth="300.0" minWidth="150.0" prefWidth="250.0" text="NOM" />
            <TableColumn fx:id="colDescription" prefWidth="400.0" text="DESCRIPTION" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
